# Copy to .env and adjust as needed:
#   cp .env.dist .env
#
# Shell environment variables take precedence over values in .env.
# All settings are optional — SoloCrawl works with no configuration.

# --- Opt-in search providers (comma-separated) ---
# SOLOCRAWL_ENABLE_PROVIDERS=arxiv,hackernews,pubmed,wikidata
# SOLOCRAWL_SEARXNG_URL=https://searx.example

# --- Concurrency and timeouts ---
# SOLOCRAWL_MAX_CONCURRENCY=10
# SOLOCRAWL_PER_DOMAIN_LIMIT=2
# SOLOCRAWL_TIMEOUT_SECONDS=30
# SOLOCRAWL_MAX_RETRIES=3

# --- Proxy (disabled by default) ---
# SOLOCRAWL_PROXY_ENABLED=false
# SOLOCRAWL_PROXY_MODE=list
# SOLOCRAWL_PROXY_LIST=
# SOLOCRAWL_PROXY_ENDPOINT=
# SOLOCRAWL_PROXY_USERNAME=
# SOLOCRAWL_PROXY_PASSWORD=

# --- Fetch / scraping ---
# SOLOCRAWL_ALLOW_INTERNAL_URLS=false
# SOLOCRAWL_USER_AGENT=
# SOLOCRAWL_RESPECT_ROBOTS=true
# SOLOCRAWL_CACHE_TTL_SECONDS=0
# SOLOCRAWL_MAX_RESPONSE_BYTES=10485760

# --- Browser fallback ---
# SOLOCRAWL_BROWSER_ALLOWED=true

# --- Logging (CLI and MCP) ---
# SOLOCRAWL_LOG_LEVEL=WARNING
# SOLOCRAWL_LOG_FILE=~/.local/state/solocrawl/mcp.log

# --- Optional API keys ---
# SOLOCRAWL_STACKEXCHANGE_KEY=
