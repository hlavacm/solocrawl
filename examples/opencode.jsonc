{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "solocrawl": {
      "type": "local",
      "command": ["solocrawl-mcp"],
      "enabled": true,
      "environment": {
        "SOLOCRAWL_LOG_LEVEL": "INFO",
        "SOLOCRAWL_LOG_FILE": "~/.local/state/solocrawl/mcp.log"
      }
    }
  }
}
